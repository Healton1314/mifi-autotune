__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 运行期产物（含本机原始配置，勿提交）
state.json
config.json
.panel-token
plan.json
sites.json
decisions.json
guard_outage.json
autotune-log.jsonl
*.log

# 一次性的本地试验输出
_msg.txt
preview-run*.txt
run-*.txt

# 打包产物
dist/
build/
*.egg-info/

.DS_Store
Thumbs.db
.idea/
.vscode/

# 实机位置记忆的临时备份（含真实 PCI/速度），别提交
sites.json.bak*

# 导出的位置记忆（含真实 PCI / 速度），只在本机之间搬，别提交
mifi-memory*.json

# ---- Android / APK ----
# Chaquopy 的源集目录由 Gradle 的 stagePython 任务生成，不进版本库
android/app/src/main/python/
android/.gradle/
android/local.properties
android/app/build/
android/build/
# ---- 构建产物：成品只在本机，进版本库的一律是源码 ----
# 自测阶段尤其要挡死：仓库是公开的，半成品包传上去就等于发了。
*.apk
*.aab
*.ipa
*.dmg
*.msi
*.jks
*.keystore
# 唯一例外：debug 签名。它不是密钥，是「同一把锁」的问题 ——
# CI 每次 runner 都新生成一把，新包装不进手机，只能卸载重装，app 的数据
# （原始设置、体检结论、位置记忆）每装一次丢一次。放一把固定的在这儿，
# 覆盖安装就正常了。它只能签 debug 包，公开也没有任何风险。
!android/debug.keystore
